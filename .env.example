# Telegram user session (Telethon). API id/hash: https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=
# StringSession; filled by `uv run python -m jobs.tg_login`
TG_SESSION=
# Peer ids in -100… form; NOTES is a taste source, DIGEST is never read as a source
NOTES_CHANNEL_ID=
DIGEST_CHANNEL_ID=

# Bot
BOT_TOKEN=
OWNER_CHAT_ID=

# Postgres (docker compose). Locally the port is bound to 127.0.0.1 only
POSTGRES_PASSWORD=
PG_PORT=5433
# backup service: a daily pg_dump at this time (Europe/Minsk), the newest N kept
# BACKUP_AT=04:30
# BACKUP_KEEP=7
DATABASE_URL=postgresql://radar:<POSTGRES_PASSWORD>@localhost:5433/radar

# OpenAI
OPENAI_API_KEY=
EMBED_MODEL=
CHEAP_MODEL=
STRONG_MODEL=
# pictures for the ⭐ drafts when the story's page has none; empty = no generation
IMAGE_MODEL=gpt-image-2

# Mailbox that receives forwarded newsletters (Medium Daily Digest); Gmail app password, never the main account
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
# your own address: digests you forward by hand from it count, nobody else's do
IMAP_TRUSTED_FROM=
